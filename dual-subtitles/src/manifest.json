{
  "manifest_version": 3,
  "name": "Dual Subtitles – YouTube, Netflix, Prime Video & Disney+",
  "short_name": "Dual Subtitles",
  "version": "1.1.0",
  "description": "Subtitles in two languages at once: the video's original language and yours. Uses the site's subtitles, or generates them from the audio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dual Subtitles",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.it/*",
    "https://www.amazon.es/*",
    "https://www.amazon.in/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.com.br/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.nl/*",
    "https://www.disneyplus.com/*",
    "https://disneyplus.com/*",
    "https://apps.disneyplus.com/*",
    "https://*.nflxvideo.net/*",
    "https://*.cloudfront.net/*",
    "https://*.media-amazon.com/*",
    "https://translate.googleapis.com/*",
    "https://translation.googleapis.com/*",
    "https://*.dssott.com/*",
    "https://*.bamgrid.com/*",
    "https://*.disney-plus.net/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.nl/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://apps.disneyplus.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.netflix.com/*",
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.nl/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://apps.disneyplus.com/*"
      ],
      "js": [
        "lib/subs.js",
        "lib/settings.js",
        "adapters/youtube.js",
        "adapters/netflix.js",
        "adapters/prime.js",
        "adapters/disney.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-listen": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or stop generating subtitles from the tab's audio"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
